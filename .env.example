# ── Database (Neon Postgres) ────────────────────────────────────────────────
# Get this from: Neon Dashboard → Your Project → Connection Details → Connection string
# Make sure to select "Pooled connection" for the game-server.
DATABASE_URL=postgresql://user:password@ep-xxx-yyy.region.aws.neon.tech/dealopoly?sslmode=require

# ── Upstash Redis ────────────────────────────────────────────────────────────
# Get these from: https://console.upstash.com → Your Database → REST API
# Required for horizontal scaling (Phase 2+). Leave blank to run in memory-only mode.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# ioredis URL for Pub/Sub (Phase 4+) — get from Upstash console → Connect tab → ioredis
# Format: rediss://default:<TOKEN>@<ENDPOINT>:<PORT>
UPSTASH_REDIS_URL=rediss://default:your_token_here@your-instance.upstash.io:6379

# ── Local service addresses ──────────────────────────────────────────────────
GAME_SERVER_PORT=4000
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:4000

